{
  "name": "omockman",
  "version": "2.3.3",
  "private": true,
  "description": "Browser DevTools extension that replaces fetch and XHR responses right in the page — no proxy, no rebuild.",
  "keywords": [
    "devtools",
    "chrome-extension",
    "firefox-addon",
    "mock",
    "api-mocking",
    "fetch",
    "xhr",
    "testing",
    "qa"
  ],
  "homepage": "https://github.com/ozontech/oMockman#readme",
  "bugs": {
    "url": "https://github.com/ozontech/oMockman/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozontech/oMockman.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest --run",
    "build": "npm run build:chrome",
    "build:chrome": "rm -rf ./dist/chrome && vite build --config vite/chrome/vite.config.ts && vite build --config vite/chrome/vite.content.config.ts && vite build --config vite/chrome/vite.inject.config.ts && vite build --config vite/chrome/vite.background.config.ts",
    "build:firefox": "rm -rf ./dist/firefox && vite build --config vite/firefox/vite.config.ts && vite build --config vite/firefox/vite.content.config.ts && vite build --config vite/firefox/vite.inject.config.ts && vite build --config vite/firefox/vite.background.config.ts",
    "pack:firefox": "npm run build:firefox && (cd dist/firefox && zip -qr ../../mockman-firefox.xpi .)",
    "preview": "vite preview",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "eslint": "eslint .",
    "eslint:fix": "npm run eslint -- --fix",
    "typescript": "tsc",
    "lint": "npm run eslint && npm run stylelint && npm run typescript",
    "lint:fix": "npm run eslint:fix && npm run stylelint:fix && npm run typescript",
    "vitest": "vitest --run",
    "vitest:watch": "vitest --watch",
    "vitest:coverage": "npm run vitest -- --coverage",
    "vitest:update": "npm run vitest -- --update",
    "playwright": "playwright test --config=playwright.config.ts",
    "playwright:ui": "playwright test --config=playwright.config.ts --ui",
    "playwright:headed": "HEADLESS=false playwright test --config=playwright.config.ts",
    "playwright:typecheck": "tsc -p tsconfig.playwright.json --noEmit",
    "allure:serve": "npx allure serve allure-results --host localhost",
    "allure:generate": "npx allure generate allure-results",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "stylelint:fix": "npm run stylelint -- --fix"
  },
  "dependencies": {
    "@codemirror/lang-json": "<7.0.0",
    "@emotion/react": "^11.10.6",
    "@types/chrome": "0.0.100",
    "@uiw/react-codemirror": "<5.0.0",
    "jsonc-parser": "<3.3.0",
    "jsonschema": "<2.0.0",
    "path-to-regexp": "^6.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.0",
    "react-toastify": "<9.0.0",
    "semantic-ui-css": "<3.0.0",
    "semantic-ui-react": "<3.0.0",
    "zustand": "<4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "3.2.6",
    "@vitest/eslint-plugin": "^1.6.23",
    "allure-playwright": "^3.4.1",
    "allure-vitest": "^3.9.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "lefthook": "^1.13.6",
    "playwright": "1.59.1",
    "postcss-scss": "^4.0.9",
    "prettier-plugin-organize-imports": "3.2.4",
    "sass": "^1.89.2",
    "stylelint": "^17.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vitest": "3.2.6"
  }
}
