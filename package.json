{
  "name": "omockman",
  "version": "2.5.0",
  "private": true,
  "description": "Browser DevTools extension that replaces fetch and XHR responses right in the page — no proxy, no rebuild.",
  "keywords": [
    "devtools",
    "chrome-extension",
    "firefox-addon",
    "mock",
    "api-mocking",
    "fetch",
    "xhr",
    "testing",
    "qa"
  ],
  "homepage": "https://github.com/ozontech/oMockman#readme",
  "bugs": {
    "url": "https://github.com/ozontech/oMockman/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozontech/oMockman.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest --run",
    "build": "npm run build:chrome",
    "build:chrome": "vite build --config vite/chrome/vite.config.ts && vite build --config vite/chrome/vite.content.config.ts && vite build --config vite/chrome/vite.inject.config.ts && vite build --config vite/chrome/vite.background.config.ts",
    "build:firefox": "vite build --config vite/firefox/vite.config.ts && vite build --config vite/firefox/vite.content.config.ts && vite build --config vite/firefox/vite.inject.config.ts && vite build --config vite/firefox/vite.background.config.ts",
    "pack:firefox": "npm run build:firefox && node scripts/pack.mjs firefox",
    "preview": "vite preview",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "eslint": "eslint .",
    "eslint:fix": "npm run eslint -- --fix",
    "typescript": "tsc",
    "lint": "npm run eslint && npm run stylelint && npm run typescript",
    "lint:fix": "npm run eslint:fix && npm run stylelint:fix && npm run typescript",
    "vitest": "vitest --run",
    "vitest:watch": "vitest --watch",
    "vitest:coverage": "npm run vitest -- --coverage",
    "vitest:update": "npm run vitest -- --update",
    "playwright": "playwright test --config=playwright.config.ts",
    "playwright:ui": "playwright test --config=playwright.config.ts --ui",
    "playwright:headed": "HEADLESS=false playwright test --config=playwright.config.ts",
    "playwright:typecheck": "tsc -p tsconfig.playwright.json --noEmit",
    "allure:serve": "npx allure serve allure-results --host localhost",
    "allure:generate": "npx allure generate allure-results",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "stylelint:fix": "npm run stylelint -- --fix",
    "test:protocol": "npm test --workspace @mockman/automation-protocol",
    "test:mcp": "npm test --workspace @mockman/mcp-server",
    "build:mcp": "node packages/mcp-server/scripts/build.mjs",
    "test:mcp:artifact": "node packages/mcp-server/scripts/test-artifact.mjs",
    "test:mcp:browser": "node packages/mcp-server/browser/chromium.js",
    "test:mcp:firefox": "node packages/mcp-server/browser/firefox.js",
    "pack": "npm run build:chrome && npm run build:firefox && npm run build:mcp && npm run check:public && node scripts/pack.mjs",
    "pack:chrome": "npm run build:chrome && node scripts/pack.mjs chrome",
    "pack:mcp": "npm run build:mcp && node scripts/pack.mjs mcp",
    "check:public": "node scripts/check-public-content.mjs"
  },
  "dependencies": {
    "@codemirror/lang-json": "<7.0.0",
    "@emotion/react": "^11.10.6",
    "@mockman/automation-protocol": "0.2.0",
    "@types/chrome": "0.3.7",
    "@uiw/react-codemirror": "<5.0.0",
    "jsonc-parser": "<3.4.0",
    "jsonschema": "<2.0.0",
    "path-to-regexp": "^6.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.0",
    "react-toastify": "<9.0.0",
    "semantic-ui-css": "<3.0.0",
    "semantic-ui-react": "<3.0.0",
    "zustand": "<4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "3.2.7",
    "@vitest/eslint-plugin": "1.6.28",
    "allure-playwright": "^3.14.0",
    "allure-vitest": "^3.14.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "fflate": "^0.8.3",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "lefthook": "^1.13.6",
    "playwright": "1.65.1",
    "postcss-scss": "^4.0.9",
    "prettier-plugin-organize-imports": "3.2.4",
    "sass": "^1.108.2",
    "stylelint": "^16.26.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "3.2.7"
  },
  "workspaces": [
    "packages/automation-protocol",
    "packages/mcp-server"
  ]
}
