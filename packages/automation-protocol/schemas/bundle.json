{
  "type": "object",
  "properties": {
    "scenarioKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
    },
    "collection": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "mocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          },
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^https?://[^/?#\\s]+[^#\\s]*$"
          },
          "name": {
            "type": "string",
            "maxLength": 4096
          },
          "response": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "minimum": 200,
                "maximum": 599
              },
              "headers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
                      "maxLength": 256
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^[^\\r\\n]*$",
                      "maxLength": 8192
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100
              },
              "body": {
                "type": "string",
                "maxLength": 1048576
              },
              "delayMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60000
              }
            },
            "required": [
              "status",
              "headers",
              "body"
            ],
            "additionalProperties": false
          },
          "enabled": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer",
            "minimum": -10000,
            "maximum": 10000
          },
          "when": {
            "type": "object",
            "properties": {
              "query": {
                "type": "object",
                "maxProperties": 50,
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "params": {
                "type": "object",
                "maxProperties": 50,
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "body": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "equals": {}
                  },
                  "required": [
                    "path",
                    "equals"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "key",
          "method",
          "url",
          "response"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    },
    "scenario": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
              },
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^https?://[^/?#\\s]+[^#\\s]*$"
              },
              "respond": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "mockKey": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
                      }
                    },
                    "required": [
                      "mockKey"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "network": {
                        "const": true
                      }
                    },
                    "required": [
                      "network"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "key",
              "method",
              "url",
              "respond"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "enabled",
        "rules"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "key",
        "name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "scenarioKey",
    "collection",
    "mocks",
    "scenario"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mockman.example/schema/automation/v1/bundle.json"
}
